{
  "version": 2,
  "name": "grabbit-menus-pamplemousses",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/menu/:id",
      "destination": "/api/menu-page?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
